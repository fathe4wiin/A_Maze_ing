from mlx import Mlx

class Label:
    def __init__(self, mlx, mlx_ptr, win, x, y, text, color):
        self.mlx = mlx
        self.mlx_ptr = mlx_ptr
        self.win = win
        self.x = x
        self.y = y
        self.text = text
        self.color = color

    def draw(self):
        """Draw the label on the window."""
        self.mlx.mlx_string_put(self.mlx_ptr, self.win, self.x, self.y, self.color, self.text)

class Button:
    def __init__(self, mlx, mlx_ptr, win, x, y, w, h, color, text, text_color=0xFFFFFFFF):
        self.mlx = mlx
        self.mlx_ptr = mlx_ptr
        self.win = win
        self.x = x
        self.y = y
        self.w = w
        self.h = h
        self.color = color
        self.text = text
        self.text_color = text_color
        # Create a Label for the button text
        self.label = Label(mlx, mlx_ptr, win, x + 10, y + (h // 2) - 10, text, text_color)

    def draw(self):
        """Draw the button (rect + label) on the window."""
        # Draw button background
        for i in range(self.x, self.x + self.w):
            for j in range(self.y, self.y + self.h):
                self.mlx.mlx_pixel_put(self.mlx_ptr, self.win, i, j, self.color)
        
        # Draw button label
        self.label.draw()

    def is_clicked(self, mx, my):
        """Check if mouse coordinates are inside the button."""
        return self.x <= mx <= self.x + self.w and self.y <= my <= self.y + self.h

if __name__ == "__main__":
    mlx = Mlx()
    mlx_ptr = mlx.mlx_init()
    win = mlx.mlx_new_window(mlx_ptr, 800, 600, "UI Demo")

    # Create instances
    lbl = Label(mlx, mlx_ptr, win, 350, 50, "My Game Menu", 0xFFFFFF00)
    btn = Button(mlx, mlx_ptr, win, 300, 200, 200, 50, 0xFF0000FF, "Click Me!", 0xFFFFFFFF)

    def render_loop(_):
        # We don't clear the screen here for simplicity/performance in this demo
        lbl.draw()
        btn.draw()

    def mouse_hook(button, x, y, _):
        if button == 1: # Left click
            if btn.is_clicked(x, y):
                print("Button was clicked!")
                # Change color on click as feedback
                btn.color = 0xFF00FF00 

    mlx.mlx_mouse_hook(win, mouse_hook, None)
    mlx.mlx_loop_hook(mlx_ptr, render_loop, None)
    mlx.mlx_loop(mlx_ptr)
